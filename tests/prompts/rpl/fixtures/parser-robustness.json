[
  {
    "id": "parser-fenced-json",
    "description": "Uses fenced JSON object exactly as instructed.",
    "output": "```json\n{\"u\":\"u-1\",\"age\":22}\n```",
    "expectation": {
      "u": "u-1",
      "age": 22
    }
  },
  {
    "id": "parser-unquoted-keys-single-quotes",
    "description": "Normalizes unquoted keys and single-quoted strings.",
    "output": "{ u: 'u-2', level: 'critical' }",
    "expectation": {
      "u": "u-2",
      "level": "critical"
    }
  },
  {
    "id": "parser-trailing-comma",
    "description": "Repairs trailing comma in object literal.",
    "output": "{\"patient\": \"p-1\", \"count\": 3, \"approved\": true,}",
    "expectation": {
      "patient": "p-1",
      "count": 3,
      "approved": true
    }
  },
  {
    "id": "parser-colon-lvar-bindings",
    "description": "Near-JSON with logical-var keys repaired by jsonrepair.",
    "output": "{ ?ticket: 'INC-42', ?state: 'open' }",
    "expectation": {
      "ticket": "INC-42",
      "state": "open"
    }
  },
  {
    "id": "parser-last-json-object-wins",
    "description": "Selects the last JSON object from mixed model output.",
    "output": "Reasoning: {not-json}\n{\"candidate\":\"old\"}\nfinal:\n{\"candidate\":\"new\"}",
    "expectation": {
      "candidate": "new"
    }
  }
]
