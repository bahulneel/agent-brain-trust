[
  {
    "id": "shared-direct-fact-binding",
    "description": "Ground fact binds lvar from goal.",
    "rpl": ["account('acct-1')"],
    "output": "account(?id)",
    "expectation": {
      "id": "acct-1"
    }
  },
  {
    "id": "shared-rule-derivation-binding",
    "description": "Head derived from tail relation.",
    "rpl": [
      "eligible(?u) <- registered(?u), age(?u, ?n), ?n >= 18",
      "registered('u-1')",
      "age('u-1', 22)"
    ],
    "output": "eligible(?u)",
    "expectation": {
      "u": "u-1"
    }
  },
  {
    "id": "shared-single-quote-string",
    "description": "Arity-1 type assertion: valid severity label.",
    "rpl": ["valid-severity('critical')"],
    "output": "valid-severity(?level)",
    "expectation": {
      "level": "critical"
    }
  }
]
